# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8081

# GCP
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=global

# GCP Pub/Sub
# Local: usar sufijo -local  |  Prod: sin sufijo
PUBSUB_SUBSCRIPTION_ID=brecha-worker-sub-local
PUBSUB_CATALOG_REFRESH_SUBSCRIPTION_ID=brecha-catalog-refresh-sub-local

# Vertex AI / Gemini
GEMINI_MODEL_NAME=gemini-3.1-pro-preview
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_DELAY=2

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# BETO Classifier
BETO_MODEL_DIR=modelo_beto
BETO_BASE_MODEL=dccuchile/bert-base-spanish-wwm-cased

# Worker Settings
MAX_WORKERS=1
WORKER_TIMEOUT=300
