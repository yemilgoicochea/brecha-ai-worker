# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# GCP
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1

# GCP Pub/Sub
PUBSUB_SUBSCRIPTION_ID=brecha-worker-sub
PUBSUB_TOPIC_ID=brecha-classification-topic
PUBSUB_MAX_MESSAGES=1
PUBSUB_ACK_DEADLINE=600

# Vertex AI / Gemini
GEMINI_MODEL_NAME=gemini-1.5-flash
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_DELAY=2

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_TABLE=project_queries
SUPABASE_CLASSIFICATIONS_TABLE=project_classifications

# Worker Settings
MAX_WORKERS=1
WORKER_TIMEOUT=300
